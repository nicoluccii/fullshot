{
  "manifest_version": 3,
  "name": "Fullshot",
  "version": "0.1.0",
  "description": "Kopiert die gesamte Webseite als PNG in die Zwischenablage.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "Fullshot: ganze Seite kopieren",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
